<?xml version="1.0" encoding="UTF-8"?>
<!-- IntelliJ IDEA module file — open the project folder directly in IntelliJ -->
<!-- IntelliJ will auto-detect pom.xml and configure everything.             -->
<!-- Just: File → Open → select the LiveAuctionSystem folder                 -->
<module type="JAVA_MODULE" version="4">
  <component name="NewModuleRootManager" inherit-compiler-output="false">
    <output url="file://$MODULE_DIR$/target/classes"/>
    <output-test url="file://$MODULE_DIR$/target/test-classes"/>
    <exclude-output/>
    <content url="file://$MODULE_DIR$">
      <sourceFolder url="file://$MODULE_DIR$/src/main/java" isTestSource="false"/>
      <sourceFolder url="file://$MODULE_DIR$/src/main/webapp" isTestSource="false"/>
    </content>
    <orderEntry type="inheritedJdk"/>
    <orderEntry type="sourceFolder" forTests="false"/>
  </component>
</module>
